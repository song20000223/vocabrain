# ── AI 判词（二选一）──
# 直连 DeepSeek（推荐，部署到 Railway/Render 等任意平台可用）
DEEPSEEK_API_KEY=
# 模型名（可选，默认 deepseek-chat）
# DEEPSEEK_MODEL=deepseek-chat

# Kimi 平台网关（仅本平台内自动注入，独立部署无需配置）
# KIMI_AGENTGW_API_KEY=
# KIMI_AGENTGW_BASE_URL=

# ── 跨域白名单（生产部署时配置）──
# 逗号分隔，如 https://your-site.netlify.app
ALLOWED_ORIGINS=

# ── 端口（平台自动注入，本地默认 3000）──
# PORT=3000
